			<fk name="Fk" to_schema="public" to_table="TRASY" type="Identifying" mandatory="y" cardinality="OneMore" range_from="0" range_to="0" delete_action="setNull" options="" >
				<fk_column name="id_trasy_docelowej" pk="id_trasy" />
			</fk>
			<fk name="FK_ZMIANY_SKLADU POSTOJE" to_schema="public" to_table="POSTOJE" type="Identifying" mandatory="y" cardinality="OneMore" range_from="0" range_to="0" delete_action="cascade" options="" >
				<fk_column name="id_trasy" pk="id_trasy" />
				<fk_column name="numer_postoju" pk="numer_postoju" />
			</fk>
