		<table name="ZMIANY_SKLADU" spec="" >
			<column name="id_zmiany" type="TEXT" mandatory="y" />
			<column name="id_trasy" type="TEXT" mandatory="y" />
			<column name="numer_postoju" type="TEXT" mandatory="y" />
			<column name="id_wagonu" type="TEXT" mandatory="y" />
			<column name="typ_operacji" type="TYP_OPERACJI_SKLADU" mandatory="y" />
			<column name="id_trasy_docelowej" type="TEXT" />
			<column name="opis" type="VARCHAR" length="200" />
			<index name="pk_ZMIANY_SKLADU" unique="PRIMARY_KEY" >
				<column name="id_zmiany" />
			</index>
			<fk name="Fk" to_schema="public" to_table="TRASY" type="Identifying" mandatory="y" cardinality="OneMore" range_from="0" range_to="0" delete_action="cascade" options="" >
				<fk_column name="id_trasy" pk="id_trasy" />
